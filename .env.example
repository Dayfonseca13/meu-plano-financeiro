# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq AI API calls.
# Used on the server-side to provide financial planning and conversation features.
GROQ_API_KEY="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"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET="my_super_secret_jwt_key_123!"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: O URL do seu projeto Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: A chave anônima (anon/public key) do seu projeto Supabase
SUPABASE_ANON_KEY=""

